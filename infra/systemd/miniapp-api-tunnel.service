[Unit]
Description=Reverse tunnel API (VM:8080 -> VPS:18080)
After=network-online.target
Wants=network-online.target

[Service]
User=deploy
Environment=VPS_USER=<SET_ME>
Environment=VPS_IP=<SET_ME>
ExecStart=/usr/bin/autossh -M 0 -NT \
  -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
  -o StrictHostKeyChecking=accept-new \
  -i /home/deploy/.ssh/id_ed25519 \
  -R 127.0.0.1:18080:127.0.0.1:8080 ${VPS_USER}@${VPS_IP}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

