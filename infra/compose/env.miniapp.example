# Tag of images to deploy (main, sha-<short>, or a release tag)
MINIAPP_TAG=main

# --- Bot configuration (no secrets here; copy to .env.miniapp and fill) ---
# TELEGRAM_TOKEN=  # set in .env.miniapp on the server
TELEGRAM_BOT_NAME=miniapp_bot

# API base for the bot to call
API_BASE_URL=http://api:8080

# Default language
DEFAULT_LANG=ru

# Cal.com settings
CAL_USERNAME=dmitrybond
CAL_EVENT_INTRO=intro-30m
CAL_HOST=cal.com

# Optional deep link to the web app (Caddy proxies domain to 5173)
WEBAPP_URL=http://127.0.0.1:5173

## MiniApp environment example for docker compose

# API
CAL_USERNAME=dmitrybond
CAL_HOST=cal.com
DEFAULT_LANG=ru

# BOT
TELEGRAM_TOKEN=
TELEGRAM_BOT_NAME=db_ai_avatar_bot
API_BASE_URL=http://api:8080
CAL_EVENT_INTRO=intro-30m
WEBAPP_URL=https://miniapp.dmitrybond.tech

# WEB (client)
VITE_API_BASE_URL=https://miniapp.dmitrybond.tech
VITE_DEFAULT_LANG=ru

