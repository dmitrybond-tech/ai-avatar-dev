# --- MiniApp Environment Variables Example ---
# Copy this file to .env.miniapp and fill in your values
# IMPORTANT: Never commit .env.miniapp to git (it contains secrets)

# --- GHCR Image Configuration ---
# Image tag for deployment (main, sha-<shortsha>, or semver)
IMAGE_TAG=main
# GHCR image references
IMAGE_API=ghcr.io/OWNER/ai-avatar-miniapp-api
IMAGE_WEB=ghcr.io/OWNER/ai-avatar-miniapp-web
IMAGE_BOT=ghcr.io/OWNER/ai-avatar-miniapp-bot

# --- Telegram Bot Configuration ---
# REQUIRED: Get token from @BotFather after creating a bot
TELEGRAM_TOKEN=__REQUIRED_FROM_BOTFATHER__
# REQUIRED: Public username of your bot (without @)
TELEGRAM_BOT_NAME=db_ai_avatar_bot
# REQUIRED: Bot mode: polling (default) or webhook
BOT_MODE=polling
# Inline quick menu (leave blank to hide the button)
TELEGRAM_MINIAPP_URL=https://miniapp.dmitrybond.tech/miniapp
TELEGRAM_BOOKING_URL=https://cal.com/dmitrybond/intro-call

# --- API Configuration ---
# API base URL for bot to call (internal Docker network)
# REQUIRED: Internal API URL (container network)
API_BASE_URL=http://api:8000
# Default language (ru or en)
# REQUIRED: Default language (ru or en)
DEFAULT_LANG=ru

# --- Cal.com Integration ---
CAL_USERNAME=dmitrybond
CAL_EVENT_INTRO=intro-30m
CAL_HOST=cal.com

# --- Web App Configuration ---
# Public URL where the web app is accessible (used in Telegram WebApp button)
# For production: https://miniapp.dmitrybond.tech/miniapp/
# For local dev: http://127.0.0.1:5175
# REQUIRED: Public base URL (no trailing slash)
WEBAPP_URL=https://miniapp.dmitrybond.tech

# MiniApp + External links for bot menu
# If MINIAPP_URL is not set, bot falls back to WEBAPP_URL
MINIAPP_URL=https://miniapp.dmitrybond.tech
CAL_URL=https://cal.com/dmitrybond/intro-call
BRIEF_URL=https://tally.so/r/your-form

# --- Frontend Build Variables ---
# These are passed to Vite during build (via Dockerfile ARG)
# Public API base URL for frontend to call
VITE_API_BASE_URL=/api
# Default language for frontend
VITE_DEFAULT_LANG=ru
VITE_SUPPORTED_LANGS=ru,en

# --- Notion Integration ---
# REQUIRED: Notion integration token (internal use only)
NOTION_API_KEY=secret_notion_token
# REQUIRED: Skills database id
NOTION_DB_SKILLS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# REQUIRED: Public tasks database id
NOTION_PUBLIC_TASKS_DB_ID=yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
# Optional tuning
NOTION_TIMEOUT=10
NOTION_CACHE_TTL_SKILLS=300
NOTION_CACHE_TTL_TASKS=300

# --- Optional: Cache Configuration (if needed) ---
# CACHE_TTL_SECONDS=600

# --- Brief Upload Configuration ---
# REQUIRED for brief upload feature: Telegram bot token (same as TELEGRAM_TOKEN or separate)
TELEGRAM_BOT_TOKEN=123:ABC...
# REQUIRED for brief upload feature: Telegram chat ID where briefs will be sent
TELEGRAM_ADMIN_CHAT_ID=123456789
# Optional: Maximum upload size in MB (default: 25)
MAX_UPLOAD_MB=25
# Optional: Allowed file extensions (comma-separated, default: pdf,doc,docx,txt,png,jpg,jpeg,zip)
ALLOWED_EXT=pdf,doc,docx,txt,png,jpg,jpeg,zip
UPLOAD_DIR=/app/uploads
CORS_ORIGINS=https://miniapp.dmitrybond.tech
TELEGRAM_SEND_REQUIRED=false

