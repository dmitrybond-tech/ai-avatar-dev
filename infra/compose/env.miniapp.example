# --- MiniApp Environment Variables Example ---
# Copy this file to .env.miniapp and fill in your values
# IMPORTANT: Never commit .env.miniapp to git (it contains secrets)

# --- GHCR Image Configuration ---
# Image tag for deployment (main, sha-<shortsha>, or semver)
IMAGE_TAG=main
# GHCR image references
IMAGE_API=ghcr.io/dmitrybond-tech/ai-avatar-miniapp-api
IMAGE_WEB=ghcr.io/dmitrybond-tech/ai-avatar-miniapp-web
IMAGE_BOT=ghcr.io/dmitrybond-tech/ai-avatar-miniapp-bot

# --- Telegram Bot Configuration ---
# REQUIRED: Get token from @BotFather after creating a bot
TELEGRAM_TOKEN=__REQUIRED_FROM_BOTFATHER__
# REQUIRED: Public username of your bot (without @)
TELEGRAM_BOT_NAME=db_ai_avatar_bot
# REQUIRED: Bot mode: polling (default) or webhook
BOT_MODE=polling

# --- API Configuration ---
# API base URL for bot to call (internal Docker network)
# REQUIRED: Internal API URL (container network)
API_BASE_URL=http://api:8080
# Default language (ru or en)
# REQUIRED: Default language (ru or en)
DEFAULT_LANG=ru

# --- Cal.com Integration ---
CAL_USERNAME=dmitrybond
CAL_EVENT_INTRO=intro-30m
CAL_HOST=cal.com

# --- Web App Configuration ---
# Public URL where the web app is accessible (used in Telegram WebApp button)
# For production: https://miniapp.dmitrybond.tech/miniapp/
# For local dev: http://127.0.0.1:5175
# REQUIRED: Public base URL (no trailing slash)
WEBAPP_URL=https://miniapp.dmitrybond.tech

# MiniApp + External links for bot menu
# If MINIAPP_URL is not set, bot falls back to WEBAPP_URL
MINIAPP_URL=https://miniapp.dmitrybond.tech
CAL_URL=https://cal.com/dmitrybond/intro-call
BRIEF_URL=https://tally.so/r/your-form

# --- Frontend Build Variables ---
# These are passed to Vite during build (via Dockerfile ARG)
# Public API base URL for frontend to call
VITE_API_BASE_URL=https://miniapp.dmitrybond.tech
# Default language for frontend
VITE_DEFAULT_LANG=ru

# --- Optional: Notion Integration (if needed) ---
# NOTION_DB=
# NOTION_SECRET=

# --- Optional: Cache Configuration (if needed) ---
# CACHE_TTL_SECONDS=600

