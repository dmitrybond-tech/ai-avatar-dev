# Telegram Bot Configuration
TELEGRAM_BOT_NAME=YourBotName
TELEGRAM_TOKEN=your_bot_token_from_botfather
# Chat configuration
CHAT_DB_URL=sqlite:////app/data/chat.db
SMART_CHAT=on
RAG_MODE=llm
CHAT_PERSONA=dima

# LLM provider (choose one block)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.1-70b-versatile
# GROQ_API_KEY=your_groq_api_key

# Telegram quick menu links
TELEGRAM_MINIAPP_URL=https://your-miniapp-url.example
TELEGRAM_BOOKING_URL=https://your-booking-url.example

# Mini App Frontend URL
WEBAPP_URL=http://localhost:5173/miniapp/

# Notion Integration
NOTION_DB=your_notion_database_id
NOTION_SECRET=your_notion_integration_secret
NOTION_DB_SKILLS=your_skills_database_id_optional
NOTION_TIMEOUT=10
NOTION_CACHE_TTL_SKILLS=300
# Skills provider mode: auto | notion | csv
SKILLS_SOURCE=auto
# Path to CSV fallback (relative to repo, used when running locally or in Docker)
SKILLS_CSV_PATH=apps/api/data/skills.csv

# External Links
CAL_LINK=https://cal.com/youraccount

# Cache Configuration
CACHE_TTL_SECONDS=600

# Gateway Service
GATEWAY_PORT=8080

