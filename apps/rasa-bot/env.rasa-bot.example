# Rasa OSS Assistant Environment Variables
# Copy this file to .env.rasa-bot in the root directory and fill in your actual values

# Telegram Bot Configuration
TELEGRAM_TOKEN=
TELEGRAM_BOT_NAME=

# Notion Integration
NOTION_SECRET=
NOTION_DB=

# Calendar/Meeting Link (optional)
CAL_LINK=

# Logging
RASA_LOG_LEVEL=INFO

