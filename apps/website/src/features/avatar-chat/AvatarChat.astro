---
import Button from '@/shared/ui/Button.astro';
import Message from '@/entities/message/Message.astro';
---

<div class="avatar-chat" id="avatar-chat">
  <div class="messages" id="messages">
    <!-- Messages will be rendered here -->
  </div>

  <div class="typing-indicator" id="typing-indicator" style="display: none;">
    <span></span><span></span><span></span>
  </div>

  <div class="input-area">
    <input
      type="text"
      id="message-input"
      placeholder="Type your message..."
      class="message-input"
    />
    <Button id="send-btn">Send</Button>
    <Button id="listen-btn" variant="secondary">Listen</Button>
  </div>

  <audio id="audio-player" style="display: none;"></audio>
</div>

<style>
  .avatar-chat {
    display: flex;
    flex-direction: column;
    height: 100%;
    max-width: 800px;
    margin: 0 auto;
  }

  .messages {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .typing-indicator {
    padding: 1rem;
    display: flex;
    gap: 0.5rem;
  }

  .typing-indicator span {
    width: 8px;
    height: 8px;
    background: #9ca3af;
    border-radius: 50%;
    animation: typing 1.4s infinite;
  }

  .typing-indicator span:nth-child(2) {
    animation-delay: 0.2s;
  }

  .typing-indicator span:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes typing {
    0%, 60%, 100% {
      transform: translateY(0);
      opacity: 0.7;
    }
    30% {
      transform: translateY(-10px);
      opacity: 1;
    }
  }

  .input-area {
    padding: 1rem;
    border-top: 1px solid #e5e7eb;
    display: flex;
    gap: 0.5rem;
  }

  .message-input {
    flex: 1;
    padding: 0.75rem 1rem;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    font-size: 1rem;
  }

  .message-input:focus {
    outline: none;
    border-color: #4f46e5;
  }
</style>

<script>
  import { WsClient, RestClient } from '@ai-avatar/clients';
  import type { WsEnvelope, ChatMessage } from '@ai-avatar/shared';
  import { config } from '@/shared/lib/config.ts';

  interface Message {
    role: 'user' | 'assistant';
    content: string;
  }

  class AvatarChatController {
    private wsClient: WsClient;
    private restClient: RestClient;
    private messages: Message[] = [];
    private sessionId: string | null = null;
    private currentAssistantMessage = '';
    private lastAssistantResponse = '';

    private messagesEl: HTMLElement;
    private inputEl: HTMLInputElement;
    private sendBtn: HTMLButtonElement;
    private listenBtn: HTMLButtonElement;
    private typingEl: HTMLElement;
    private audioPlayer: HTMLAudioElement;

    constructor() {
      // Get DOM elements
      this.messagesEl = document.getElementById('messages')!;
      this.inputEl = document.getElementById('message-input') as HTMLInputElement;
      this.sendBtn = document.getElementById('send-btn') as HTMLButtonElement;
      this.listenBtn = document.getElementById('listen-btn') as HTMLButtonElement;
      this.typingEl = document.getElementById('typing-indicator')!;
      this.audioPlayer = document.getElementById('audio-player') as HTMLAudioElement;

      // Initialize clients
      this.wsClient = new WsClient({ url: config.wsUrl });
      this.restClient = new RestClient(config.apiBaseUrl);

      this.setupListeners();
      this.connectWebSocket();
    }

    private setupListeners() {
      this.sendBtn.addEventListener('click', () => this.sendMessage());
      this.listenBtn.addEventListener('click', () => this.playLastResponse());
      
      this.inputEl.addEventListener('keypress', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          this.sendMessage();
        }
      });

      // Audio events
      this.audioPlayer.addEventListener('play', () => {
        window.dispatchEvent(new Event('audio-play'));
      });
      this.audioPlayer.addEventListener('pause', () => {
        window.dispatchEvent(new Event('audio-pause'));
      });
      this.audioPlayer.addEventListener('ended', () => {
        window.dispatchEvent(new Event('audio-ended'));
      });
    }

    private connectWebSocket() {
      this.wsClient.addListener((msg) => this.handleWsMessage(msg));
      this.wsClient.connect();
    }

    private handleWsMessage(msg: WsEnvelope) {
      switch (msg.type) {
        case 'connected':
          console.log('WebSocket connected', msg.session_id);
          if (msg.session_id) {
            this.sessionId = msg.session_id;
          }
          break;

        case 'partial':
          this.currentAssistantMessage += msg.delta;
          this.updateAssistantMessage();
          break;

        case 'final':
          this.typingEl.style.display = 'none';
          if (msg.session_id) {
            this.sessionId = msg.session_id;
          }
          this.lastAssistantResponse = this.currentAssistantMessage;
          this.finalizeAssistantMessage();
          this.currentAssistantMessage = '';
          break;

        case 'error':
          console.error('WebSocket error:', msg.message);
          this.typingEl.style.display = 'none';
          break;
      }
    }

    private sendMessage() {
      const text = this.inputEl.value.trim();
      if (!text || !this.wsClient.isConnected()) return;

      // Add user message
      this.messages.push({ role: 'user', content: text });
      this.renderMessages();
      this.inputEl.value = '';

      // Show typing indicator
      this.typingEl.style.display = 'flex';
      this.currentAssistantMessage = '';

      // Send via WebSocket
      this.wsClient.send({
        type: 'user_message',
        text,
        session_id: this.sessionId || undefined,
      });

      // Scroll to bottom
      this.scrollToBottom();
    }

    private updateAssistantMessage() {
      // Update the last message if it's assistant, otherwise add new
      const lastMsg = this.messages[this.messages.length - 1];
      if (lastMsg && lastMsg.role === 'assistant') {
        lastMsg.content = this.currentAssistantMessage;
      } else {
        this.messages.push({ role: 'assistant', content: this.currentAssistantMessage });
      }
      this.renderMessages();
      this.scrollToBottom();
    }

    private finalizeAssistantMessage() {
      const lastMsg = this.messages[this.messages.length - 1];
      if (lastMsg && lastMsg.role === 'assistant') {
        lastMsg.content = this.currentAssistantMessage;
      }
      this.renderMessages();
      this.scrollToBottom();
    }

    private renderMessages() {
      this.messagesEl.innerHTML = this.messages
        .map((msg) => this.renderMessage(msg))
        .join('');
    }

    private renderMessage(msg: Message): string {
      const roleClass = `message-${msg.role}`;
      const roleLabel = msg.role === 'user' ? 'You' : 'Avatar';
      return `
        <div class="message ${roleClass}">
          <div class="message-role">${roleLabel}</div>
          <div class="message-content">${this.escapeHtml(msg.content)}</div>
        </div>
      `;
    }

    private escapeHtml(text: string): string {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    private scrollToBottom() {
      setTimeout(() => {
        this.messagesEl.scrollTop = this.messagesEl.scrollHeight;
      }, 0);
    }

    private async playLastResponse() {
      if (!this.lastAssistantResponse) {
        console.warn('No response to play');
        return;
      }

      try {
        this.listenBtn.disabled = true;
        const response = await this.restClient.tts({
          text: this.lastAssistantResponse.slice(0, 500), // Limit to 500 chars
        });

        this.audioPlayer.src = config.apiBaseUrl + response.audio_url;
        await this.audioPlayer.play();
      } catch (error) {
        console.error('TTS error:', error);
      } finally {
        this.listenBtn.disabled = false;
      }
    }
  }

  // Initialize chat controller
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      new AvatarChatController();
    });
  } else {
    new AvatarChatController();
  }
</script>

<style is:inline>
  .message {
    margin-bottom: 1rem;
    padding: 1rem;
    border-radius: 0.75rem;
    max-width: 80%;
  }

  .message-user {
    align-self: flex-end;
    background: #4f46e5;
    color: white;
    margin-left: auto;
  }

  .message-assistant {
    align-self: flex-start;
    background: #f3f4f6;
    color: #1f2937;
  }

  .message-role {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
    opacity: 0.8;
  }

  .message-content {
    font-size: 1rem;
    line-height: 1.5;
    white-space: pre-wrap;
    word-wrap: break-word;
  }
</style>

