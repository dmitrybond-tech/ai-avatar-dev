{
  "name": "ai-avatar",
  "version": "0.1.0",
  "private": true,
  "description": "AI Avatar monorepo - lightweight chatbot with Telegram Web App",
  "scripts": {
    "dev": "pnpm --filter website dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "dev:miniapp": "pnpm --filter @ai-avatar/website dev:miniapp",
    "build:miniapp": "pnpm --filter @ai-avatar/website build:miniapp",
    "preview:miniapp": "pnpm --filter @ai-avatar/website preview:miniapp"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}

